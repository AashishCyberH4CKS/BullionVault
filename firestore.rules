rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: Block all public or unauthenticated read and write access
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict User-Isolated Data Partitioning:
    // Every operation requires a valid Firebase Auth token.
    // The authenticated user's UID (request.auth.uid) MUST match the document path userId.
    // Frontend-supplied IDs cannot forge access because Firestore security rules validate against the cryptographic token claim.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's Transactions (Gold, Silver, Platinum, Copper, Crude Oil, Natural Gas)
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's Portfolio Holdings
      match /holdings/{holdingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's Investments
      match /investments/{investmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
